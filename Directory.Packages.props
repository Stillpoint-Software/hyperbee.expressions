<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Development Tools -->
    <!--
      Build-time only: PolySharp is a source generator. Every project references it
      with PrivateAssets="all", so it never appears in this repository's package
      dependencies. See Directory.Build.props for what it generates and why.
    -->
    <PackageVersion Include="PolySharp" Version="1.17.1" />
    <PackageVersion Include="Nerdbank.GitVersioning" Version="3.10.94" />
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="11.0.100">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageVersion>
    <!-- netstandard2.1 support only; see Internal/NetstandardShims.cs and the csproj conditions. -->
    <PackageVersion Include="Microsoft.Bcl.AsyncInterfaces" Version="11.0.0" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="DotNext.Metaprogramming" Version="6.13.0" />
    <PackageVersion Include="FastExpressionCompiler" Version="6.0.0" />
    <PackageVersion Include="coverlet.collector" Version="10.1.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageVersion>
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="11.0.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="MSTest.TestAdapter" Version="4.5.3" />
    <PackageVersion Include="MSTest.TestFramework" Version="4.5.3" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="11.0.0" />
    <PackageVersion Include="Hyperbee.Json" Version="3.4.2" />
    <PackageVersion Include="Hyperbee.Expressions.Compiler" Version="1.7.3" />
    <PackageVersion Include="Hyperbee.Collections" Version="2.8.3" />
  </ItemGroup>
</Project>