<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Nullable>disable</Nullable>

    <Authors>Stillpoint Software, Inc.</Authors>
    <PackageId>Hyperbee.Expressions</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>expression-tree;expressions;async;await;expression-extension</PackageTags>
    <IsPackable>true</IsPackable>
    <Copyright>Stillpoint Software, Inc.</Copyright>
    <Title>Hyperbee Expressions</Title>
    <Description>Async and Await for .NET Expression Trees.</Description>
  </PropertyGroup>

  <PropertyGroup>
    <DefineConstants>$(DefineConstants);FAST_COMPILER</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <None Update="$(MSBuildProjectName).csproj.DotSettings" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>$(AssemblyName).Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>$(AssemblyName).Benchmark</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Hyperbee.Collections" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Update="Microsoft.SourceLink.GitHub">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>


  <!-- Shared internal helpers, compiled into each project so they stay off the public surface. -->
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)..\Shared\*.cs" LinkBase="Shared" />
  </ItemGroup>

  <!--
    netstandard2.1 needs Microsoft.Bcl.AsyncInterfaces for IAsyncEnumerable.
    The compiler-required attributes and the reflection shim are hand-written in
    src/Shared/NetstandardShims.cs; see the note there on why not Polyfill.

    The versions are pinned to 8.0.x on this target alone. The netstandard2.1 asset
    exists to serve net8.0 and net9.0 consumers, and the 11.0.0 packages declare no
    support for either, so a net8.0 consumer collected a support warning per package
    on every build, which defeats the point of offering the target. 8.0.x supports
    net8.0 upward and still ships a netstandard2.0 asset, so this costs no API that
    the netstandard2.1 sources use.
  -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.1'">
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" VersionOverride="8.0.0" />
    <PackageReference Update="Microsoft.Extensions.Configuration" VersionOverride="8.0.0" />
    <PackageReference Update="Microsoft.Extensions.Configuration.Binder" VersionOverride="8.0.2" />
    <PackageReference Update="Microsoft.Extensions.DependencyInjection" VersionOverride="8.0.1" />
  </ItemGroup>

</Project>
