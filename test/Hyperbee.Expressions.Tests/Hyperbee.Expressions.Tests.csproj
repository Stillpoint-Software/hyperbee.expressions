<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Pinned, not inherited: Directory.Build.props adds netstandard2.1 for the
      shipped libraries, and there is no test host for netstandard2.1.
    -->
    <TargetFrameworks>net11.0;net10.0</TargetFrameworks>
  </PropertyGroup>

  <PropertyGroup>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <PropertyGroup>
    <DefineConstants>$(DefineConstants);FAST_COMPILER</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="FastExpressionCompiler" />
    <PackageReference Include="Hyperbee.Json" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="MSTest.TestAdapter" />
    <PackageReference Include="MSTest.TestFramework" />
  </ItemGroup>

  <!--
    The compiler is built and released from the hyperbee.expressions.compiler repository,
    so it arrives here as a package. These tests keep the compiled-by-HEC path covered.
    The type forwards in AbstractionsForwards.cs have their own test,
    AbstractionsForwardsTests, so they stay covered whichever compiler version is pinned.

    The trade is that this suite runs against the last published compiler rather than that
    repository HEAD. The compiler's own suite covers its source.
  -->
  <ItemGroup>
    <PackageReference Include="Hyperbee.Expressions.Compiler" />
    <ProjectReference Include="..\..\src\Hyperbee.Expressions.Lab\Hyperbee.Expressions.Lab.csproj" />
    <ProjectReference Include="..\..\src\Hyperbee.Expressions\Hyperbee.Expressions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="Microsoft.SourceLink.GitHub">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>


  <!--
    Opt-in: run this suite against the netstandard2.1 build of the libraries
    instead of the matching net10.0/net11.0 build. netstandard2.1 is not a
    runtime and cannot host a test, so the tests still execute on net10.0 or
    net11.0; only the library under test changes. This is what exercises the
    #if NETSTANDARD branches and the netstandard2.1-only shims in each library's
    Internal folder.

      dotnet test <project> -f net10.0 -p:UseNetstandardAsset=true
  -->
  <ItemGroup Condition="'$(UseNetstandardAsset)' == 'true'">
    <ProjectReference Update="..\..\src\Hyperbee.Expressions\Hyperbee.Expressions.csproj"
                      SetTargetFramework="TargetFramework=netstandard2.1" />
    <!--
      The compiler is a package now, so its asset follows this project's framework and
      cannot be pinned here. This mode therefore exercises the netstandard2.1 build of
      Hyperbee.Expressions only. The compiler repository tests its own ns2.1 asset.
    -->

    <ProjectReference Update="..\..\src\Hyperbee.Expressions.Lab\Hyperbee.Expressions.Lab.csproj"
                      SetTargetFramework="TargetFramework=netstandard2.1" />
  </ItemGroup>

  <!--
    Opt-in: run the suite on the .NET 8 runtime, the way a net8.0 application uses
    the packages. Hyperbee.Expressions and Hyperbee.Expressions.Lab resolve their
    netstandard2.1 builds, as do the Hyperbee.Json and Hyperbee.Expressions.Compiler
    packages. The Microsoft.Extensions packages drop to 8.0.x, as a net8.0 application
    would reference them. It needs the .NET 8 runtime; CI does not run it.

      dotnet test test/Hyperbee.Expressions.Tests -p:TestOnNet8=true
  -->
  <PropertyGroup Condition="'$(TestOnNet8)' == 'true'">
    <TargetFrameworks>net8.0</TargetFrameworks>
    <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
  </PropertyGroup>

  <ItemGroup Condition="'$(TestOnNet8)' == 'true'">
    <PackageReference Update="Microsoft.Extensions.Configuration" VersionOverride="8.0.0" />
    <PackageReference Update="Microsoft.Extensions.DependencyInjection" VersionOverride="8.0.1" />
    <PackageReference Update="Microsoft.Extensions.Hosting" VersionOverride="8.0.1" />
    <PackageReference Update="Microsoft.Extensions.Http" VersionOverride="8.0.1" />
  </ItemGroup>

</Project>
